# Los lanzadores de Windows van tal cual: CRLF y, los .vbs, en ANSI (VBScript no lee UTF-8).
# Así git no les cambia los finales de línea al clonar en otro PC.
*.vbs -text
*.bat -text

# Lo que solo sirve en la página de GitHub (capturas del README, guías de la comunidad,
# plantillas) y la configuración de git no van en el ZIP que se descarga desde GitHub.
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
